@inherits LayoutComponentBase
@inject MidtermProject.Services.KeylabStoreService StoreService

<div class="min-h-screen flex flex-col bg-slate-50 font-sans text-slate-800">
    <!-- Navbar -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
            <!-- Brand -->
            <a href="/" class="text-2xl font-black tracking-widest text-slate-900 uppercase">KEYLAB</a>

            <!-- Nav Links -->
            <nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-slate-600">
                <a href="/shop" class="hover:text-slate-900 transition-colors">Keyboards</a>
                <a href="/shop?cat=Switches" class="hover:text-slate-900 transition-colors">Switches</a>
                <a href="/shop?cat=Keycaps" class="hover:text-slate-900 transition-colors">Keycaps</a>
                <a href="/shop?cat=Accessories" class="hover:text-slate-900 transition-colors">Accessories</a>
            </nav>

            <!-- Search Bar -->
            <div class="flex-1 max-w-xs relative hidden sm:block">
                <input type="text" placeholder="Search products..." class="w-full bg-slate-100 border border-slate-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900" />
            </div>

            <!-- Right Actions -->
            <div class="flex items-center space-x-4">
                <a href="/cart" class="relative text-sm font-semibold text-slate-700 flex items-center gap-1">
                    <span>Cart</span>
                    <span class="bg-slate-900 text-white text-xs px-2 py-0.5 rounded-full font-bold">@StoreService.GetCartCount()</span>
                </a>

                @if (StoreService.IsLoggedIn)
                {
                    <span class="text-xs font-semibold text-slate-600">Hi, @StoreService.CurrentUser</span>
                    <button @onclick="StoreService.Logout" class="text-xs text-red-600 hover:underline">Log Out</button>
                }
                else
                {
                    <a href="/login" class="text-sm font-medium px-3 py-1.5 border border-slate-300 rounded-lg hover:border-slate-900 transition-all">Log In</a>
                    <a href="/register" class="text-sm font-medium px-3 py-1.5 bg-slate-900 text-white rounded-lg hover:bg-slate-800 transition-all shadow-sm">Sign Up</a>
                }
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1">
        @Body
    </main>

    <!-- Dark Footer -->
    <footer class="bg-slate-950 text-slate-400 text-sm border-t border-slate-800 pt-12 pb-8">
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
            <div>
                <h3 class="text-white font-bold text-lg tracking-widest mb-3">KEYLAB</h3>
                <p class="text-slate-400 text-xs leading-relaxed">Minimalist mechanical keyboards for focused work.</p>
            </div>
            <div>
                <h4 class="text-white font-semibold mb-3">Shop</h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="/shop" class="hover:text-white">Keyboards</a></li>
                    <li><a href="/shop" class="hover:text-white">Switches</a></li>
                    <li><a href="/shop" class="hover:text-white">Keycaps</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-semibold mb-3">Support</h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="#" class="hover:text-white">Shipping</a></li>
                    <li><a href="#" class="hover:text-white">Returns</a></li>
                    <li><a href="#" class="hover:text-white">Contact</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-semibold mb-3">Newsletter</h4>
                <div class="flex gap-2">
                    <input type="email" placeholder="Enter your email" class="bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none w-full" />
                    <button class="bg-white text-slate-950 font-bold px-3 py-2 rounded-lg text-xs hover:bg-slate-200">Join</button>
                </div>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-6 border-t border-slate-900 pt-6 text-xs text-center text-slate-600">
            © 2026 KEYLAB. All rights reserved.
        </div>
    </footer>
</div>

@code {
    protected override void OnInitialized()
    {
        StoreService.OnStateChange += StateHasChanged;
    }
}