@page "/register"
@inject MidtermProject.Services.KeylabStoreService StoreService
@inject NavigationManager Nav

<div class="min-h-screen bg-slate-950 flex items-center justify-center p-4 md:p-8">
    <div class="max-w-4xl w-full bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl overflow-hidden grid grid-cols-1 md:grid-cols-2">
        <!-- Visual Hero Panel -->
        <div class="relative bg-gradient-to-br from-indigo-900 via-slate-900 to-slate-950 p-8 flex flex-col justify-between hidden md:flex border-r border-slate-800">
            <div>
                <span class="text-xs font-bold tracking-widest text-indigo-400 uppercase">KEYLAB Membership</span>
                <h2 class="text-3xl font-extrabold text-white mt-2">Elevate Your Typing Experience.</h2>
                <p class="text-slate-400 text-sm mt-3 leading-relaxed">Join thousands of mechanical keyboard enthusiasts building custom setups.</p>
            </div>
            <div class="bg-slate-900/60 backdrop-blur-md p-4 rounded-xl border border-slate-800">
                <p class="text-xs text-slate-300 italic">"The build quality of the Void 65 changed how I feel about typing every day."</p>
                <span class="text-[10 text-indigo-400 font-bold mt-2 block">— Alex R., Senior Software Engineer</span>
            </div>
        </div>

        <!-- Form Panel -->
        <div class="p-8 flex flex-col justify-center">
            <h1 class="text-2xl font-black text-white">Create Account</h1>
            <p class="text-slate-400 text-xs mt-1 mb-6">Join KEYLAB in under a minute.</p>

            <div class="grid grid-cols-2 gap-3 mb-4">
                <button class="flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-750 text-white text-xs font-semibold py-2.5 rounded-xl border border-slate-700 transition-all">
                    Sign up with Google
                </button>
                <button class="flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-750 text-white text-xs font-semibold py-2.5 rounded-xl border border-slate-700 transition-all">
                    Sign up with GitHub
                </button>
            </div>

            <div class="relative flex items-center justify-center my-4">
                <hr class="w-full border-slate-800" />
                <span class="absolute bg-slate-900 px-3 text-[10px] text-slate-500 uppercase tracking-wider font-bold">OR</span>
            </div>

            <EditForm Model="model" OnValidSubmit="HandleRegister" class="space-y-3">
                <DataAnnotationsValidator />
                
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Full Name</label>
                    <InputText @bind-Value="model.FullName" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Email Address</label>
                    <InputText @bind-Value="model.Email" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Password</label>
                    <InputText @bind-Value="model.Password" type="password" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Confirm Password</label>
                    <InputText @bind-Value="model.ConfirmPassword" type="password" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
                </div>

                <div class="flex items-center gap-2 pt-1">
                    <InputCheckbox @bind-Value="model.AgreeToTerms" id="agree" class="rounded bg-slate-950 border-slate-800 text-indigo-600 focus:ring-0" />
                    <label for="agree" class="text-xs text-slate-400">I agree to the <a href="#" class="text-indigo-400 hover:underline">Terms & Privacy Policy</a></label>
                </div>

                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 rounded-xl shadow-lg shadow-indigo-600/20 text-sm transition-all mt-4">
                    Create Account
                </button>
            </EditForm>

            <p class="text-center text-xs text-slate-500 mt-6">
                Already have an account? <a href="/login" class="text-indigo-400 font-semibold hover:underline">Sign In</a>
            </p>
        </div>
    </div>
</div>

@code {
    private MidtermProject.Models.RegisterModel model = new();

    private void HandleRegister()
    {
        StoreService.Login(model.FullName);
        Nav.NavigateTo("/shop");
    }
}